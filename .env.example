NODE_ENV=development
PORT=3000
TRUST_PROXY=false
ADMIN_ALLOWED_IPS=
BACKUPS_DIR=
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
# Requests per window under /api (public + admin), per client IP
API_RATE_LIMIT_MAX=5000
ADMIN_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_MS=60000

# Куда сообщать о падениях: вебхук Telegram-бота, Discord или Slack
ALERT_WEBHOOK_URL=
# Только для Telegram: id чата
ALERT_CHAT_ID=
